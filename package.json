{
  "name": "antigravity-cli",
  "displayName": "Perch for Google Antigravity CLI",
  "description": "Open Google's Antigravity CLI in a dedicated right-side panel in VS Code. Independent project, not affiliated with or endorsed by Google.",
  "version": "0.0.3",
  "publisher": "nuwanthapasindu",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nuwanthapasindu/perch-vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/Nuwanthapasindu/perch-vscode-extension/issues"
  },
  "homepage": "https://github.com/Nuwanthapasindu/perch-vscode-extension#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "perch",
    "terminal",
    "ai assistant",
    "cli",
    "developer tools",
    "google antigravity cli"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "antigravity.openTerminal",
        "title": "Open Terminal",
        "category": "Perch",
        "icon": {
          "light": "resources/icon.svg",
          "dark": "resources/icon.svg"
        }
      },
      {
        "command": "antigravity.restartTerminal",
        "title": "Restart Terminal",
        "category": "Perch",
        "icon": "$(debug-restart)"
      },
      {
        "command": "antigravity.stopTerminal",
        "title": "Stop Terminal",
        "category": "Perch",
        "icon": "$(debug-stop)"
      }
    ],
    "keybindings": [
      {
        "command": "antigravity.openTerminal",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-sidebar",
          "title": "Perch",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "antigravity-sidebar": [
        {
          "type": "webview",
          "id": "antigravity.welcomeView",
          "name": "Perch"
        }
      ]
    },
    "terminal": {
      "profiles": [
        {
          "title": "Perch",
          "id": "antigravity.terminalProfile",
          "icon": "terminal"
        }
      ]
    },
    "configuration": {
      "title": "Perch",
      "properties": {
        "perch.executable": {
          "type": "string",
          "default": "agy",
          "description": "Path to the Google Antigravity CLI executable (default: agy, assuming it is in your PATH)."
        },
        "perch.defaultArgs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Default arguments to pass to the CLI executable on launch."
        },
        "antigravity.executable": {
          "type": "string",
          "default": "agy",
          "description": "Legacy setting: Path to the agy executable.",
          "deprecationMessage": "This setting is deprecated. Please use 'perch.executable' instead."
        },
        "antigravity.defaultArgs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Legacy setting: Default arguments to pass to agy on launch.",
          "deprecationMessage": "This setting is deprecated. Please use 'perch.defaultArgs' instead."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "antigravity.openTerminal",
          "group": "navigation",
          "when": "true"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npx tsc -p ./",
    "watch": "npx tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "npx @vscode/vsce package -o perch-0.0.3.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.50.0"
  }
}
